{
  "name": "f1-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Polyglot monorepo hosting Next.js and Nuxt apps, shared libs, and services.",
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "pnpm -r start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "pnpm -r format"
  }
}
