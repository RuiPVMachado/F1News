{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./.next",
    "baseUrl": ".",
    "paths": {
      "@packages/shared": ["../../packages/shared/src"],
      "@packages/api-clients": ["../../packages/api-clients/src"]
    },
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"],
  "references": [
    { "path": "../../packages/shared" },
    { "path": "../../packages/api-clients" }
  ]
}
